{
  "evalID": "agent-supervisor-current-failure-versus-recovered-history",
  "agentID": "agent-supervisor",
  "messages": [
    {
      "role": "user",
      "content": "Review the supplied snapshot. Address every priority incident with its canonical statuses. Distinguish a recovered compactor child from current output/delivery failures. Take no action."
    }
  ],
  "tools": [
    {
      "tool": "load_skills",
      "input": {
        "skillIDs": [
          "agent-supervisor"
        ]
      },
      "output": {
        "skills": [
          {
            "skillID": "agent-supervisor",
            "name": "agent supervisor",
            "description": "Inspect synthetic run metrics",
            "instructions": "Use nightcrew_inspect overview, then each page through nextPage=null. Inspect concerning runs as needed. Cite measured evidence, take no action. Call finish with structured incidents, observations, and uncertainties. incidents must contain exactly one object for EVERY coverage.priorityIssues entry, copying runID, execution, output and delivery exactly, with your assessment and nextAction. No incident may be omitted, duplicated, or invented. Keep recovered children and optional historical findings in observations, not the active incident list. observations and uncertainties are arrays of strings: include the reviewed scope, exact supplied metrics and run IDs, recovered failures, evidence gaps and unsupported conclusions. If no priority incidents exist, use incidents: []. Do not infer delivery success from completion or call repeated tool use a bug without evidence. The exporter renders Markdown; do not write Markdown status labels or wrap a report string. Invalid finish data fails immediately without repair.",
            "files": []
          }
        ],
        "files": []
      }
    },
