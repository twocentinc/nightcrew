{
  "name": "nightcrew",
  "version": "0.44.0",
  "private": true,
  "type": "module",
  "description": "Standalone local-agent HTTP service",
  "exports": {
    ".": "./dist/server/http.js",
    "./operations": "./dist/utils/commands/operations.js"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && chmod +x dist/cli.js",
    "lint": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json",
    "test": "npm run build && node --experimental-strip-types --test test/*.test.ts examples/*/test.ts examples/*/*.test.ts",
    "prepack": "npm run build",
    "contracts:check": "npm run build && node --experimental-strip-types --test test/contracts.test.ts",
    "contracts:update": "npm run build && node --experimental-strip-types test/contracts.ts --update",
    "test:package": "npm run build && NIGHTCREW_TEST_PACKAGE=1 node --experimental-strip-types --test test/package.test.ts",
    "test:live": "node --experimental-strip-types --test test/live/*.test.ts"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@orpc/client": "1.16.2",
    "@orpc/openapi": "1.16.2",
    "@orpc/server": "1.16.2",
    "@orpc/zod": "1.16.2",
    "commander": "15.1.0",
    "cron-parser": "5.10.6",
    "eventsource-parser": "4.1.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  },
  "bin": {
    "nightcrew": "dist/cli.js"
  },
  "files": [
    "dist/",
    "README.md",
    "examples/",
    "docs/model-switch-verification.md",
    "docs/acceptance.md",
    "docs/eval-format.md",
    "docs/compatibility.md"
  ]
}
