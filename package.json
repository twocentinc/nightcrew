{
  "name": "nightcrew",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "description": "Standalone local-agent HTTP service",
  "exports": "./dist/server.js",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && chmod +x dist/cli.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build",
    "contracts:check": "npm run build && node scripts/contracts.mjs --check",
    "contracts:update": "npm run build && node scripts/contracts.mjs --update",
    "test:package": "npm run build && node scripts/package-smoke.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@orpc/client": "1.16.2",
    "@orpc/openapi": "1.16.2",
    "@orpc/server": "1.16.2",
    "@orpc/zod": "1.16.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  },
  "bin": {
    "nightcrew": "dist/cli.js"
  },
  "files": [
    "dist/",
    "README.md",
    "examples/",
    "docs/model-switch-verification.md"
  ]
}
